{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**", ".next/**", "!.next/cache/**"],
		},
		"check-types": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "tsconfig*.json"],
			"outputLogs": "new-only",
		},
		"prerelease": {
			"dependsOn": ["build"],
			"outputLogs": "new-only",
		},
		"release": {
			"cache": false,
			"dependsOn": ["prerelease"],
			"passThroughEnv": [
				"ACTIONS_ID_TOKEN_REQUEST_URL",
				"ACTIONS_ID_TOKEN_REQUEST_TOKEN",
				"GITHUB_*",
				"NODE_AUTH_TOKEN",
				"NPM_CONFIG_*",
			],
		},
		"test": {
			"dependsOn": ["test:unit"],
		},
		"test:unit": {
			"inputs": ["**/*.test.ts", "!**/*.e2e.test.ts"],
			"outputLogs": "new-only",
		},
	},
}
