{
	"name": "npm-packages",
	"private": true,
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"format": "bun fmt",
		"prepare": "bun run ./prepare.ts || true",
		"publish": "turbo run publish",
		"test": "turbo run test",
		"format:check": "bun fmt --check",
		"lint": "bun run lint:biome . && bun run lint:eslint .",
		"lint:biome": "bunx biome check --formatter-enabled=false --diagnostic-level=error",
		"lint:eslint": "bunx eslint --quiet",
		"lint:fix": "bun run lint:biome --write --unsafe . && bun run lint:eslint --fix . && bun run format"
	},
	"dependencies": {
		"npm": "^11.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@commitlint/types": "^20.5.0",
		"@eslint/js": "^10.0.1",
		"@hyoretsu/configs": "^1.2.18",
		"@swc/core": "^1.15.41",
		"@types/bun": "^1.3.11",
		"@types/node": "^25.5.0",
		"committier": "^0.2.3",
		"eslint": "^10.1.0",
		"eslint-config-biome": "^2.1.3",
		"lefthook": "^1.13.6",
		"lint-staged": "^16.4.0",
		"tsup": "^8.5.1",
		"turbo": "^2.9.18",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.57.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@swc/core",
		"bcrypt",
		"esbuild",
		"protobufjs"
	]
}
