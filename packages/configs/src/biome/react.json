{
	"$schema": "../../../../node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["./base.json"],
	"linter": {
		"rules": {
			"a11y": {
				"noLabelWithoutControl": {
					"level": "on",
					"options": {
						"inputComponents": [
							"Checkbox",
							"CurrencyInput",
							"Input",
							"MaskedInput",
							"MediaUrlInput",
							"NumericInput",
							"RgbInput",
							"Select",
							"UnitHoursInput"
						]
					}
				}
			},
			"correctness": {
				"useHookAtTopLevel": "error",
				"useUniqueElementIds": "off"
			},
			"style": {
				"useComponentExportOnlyModules": "error"
			}
		}
	},
	"root": false
}
