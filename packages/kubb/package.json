{
	"name": "@hyoretsu/kubb",
	"description": "A collection of helpers for Kubb.",
	"version": "4.0.0",
	"keywords": [],
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js",
			"require": "./dist/client.cjs"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"require": "./dist/config.cjs"
		}
	},
	"bugs": {
		"url": "https://github.com/hyoretsu/npm-packages/issues",
		"email": "hyoretsu@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hyoretsu/npm-packages.git"
	},
	"license": "MIT",
	"author": {
		"name": "Aran Leite",
		"email": "hyoretsu@gmail.com",
		"url": "https://www.linkedin.com/in/aranleite"
	},
	"scripts": {
		"prepublishOnly": "bun run build",
		"build": "tsup && tsc --emitDeclarationOnly",
		"check-types": "tsc --noEmit",
		"release": "npm publish --provenance --access public"
	},
	"dependencies": {
		"@hyoretsu/utils": "^1.18.1",
		"dayjs": "^1.11.20",
		"@kubb/adapter-oas": "^5.15.3",
		"@kubb/plugin-client": "^5.9.0",
		"@kubb/plugin-react-query": "^5.9.0",
		"@kubb/plugin-ts": "^5.4.0",
		"@kubb/plugin-zod": "^5.6.0"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.99.2",
		"ky": "^2.0.1",
		"zod": "^4.3.6",
		"kubb": "^5.15.3"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.28",
		"@types/node": "^25.6.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"trustedDependencies": [
		"es5-ext",
		"esbuild"
	]
}
