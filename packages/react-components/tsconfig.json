{
	"compilerOptions": {
		"exactOptionalPropertyTypes": false,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"noUncheckedIndexedAccess": false,
		"outDir": "dist",
		"rootDir": "src",
		"typeRoots": [
			"./node_modules/@types",
			"./src/data/@types",
			"../../node_modules/@types"
		]
	},
	"extends": "../../tsconfig.json",
	"include": [
		"src/**/*"
	]
